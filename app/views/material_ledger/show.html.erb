
<% @page_title = "Material Ledger" %>


<%= form_with model: @search, url: '/account_ledger', method: 'get', class: 'form-inline' do |f|
    = f.text_field 'text', placeholder: 'Buscar por cuenta, contacto o referencia', autocomplete: 'off'
    %label
      From
      = f.date_field 'from'
    %label
      To
      = f.date_field 'to'
    = f.select(:account_id, options_from_collection_for_select(Account.all, :id, :name, @search.account_id), include_blank:false)
    = f.submit 'Show', class: 'btn btn-primary'



<% @ledgers.each do |ledger| %>
  <%= ledger.inspect %>
<% end %>
