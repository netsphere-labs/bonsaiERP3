
:ruby
  @page_title = "Sales Order ##{@order.id}"
  @crumbs = [
    ["Sales Orders", sales_orders_path] ]

- content_for :links do
  %span{class: @order.display_state}= @order.state

  %div.btn-group{role:"group"}
    = button_to 'Confirm', confirm_sales_order_path(@order), method: :patch, class: 'btn btn-success'  if policy(@order).confirm?

    - if policy(@order).destroy?
      = button_to 'Delete', sales_order_path(@order.id), method: :delete, class: 'btn btn-outline-danger', data:{turbo_confirm: 'Sure?'}  
    - elsif policy(@order).void?
      = button_to 'Void', void_sales_order_path(@order), method: :patch, class: 'btn btn-outline-danger', data: { turbo_confirm: 'Esta segur@ de anular' }
    - else
      %a(class="btn disabled") Delete
      
    = link_to "Edit this SO...", edit_sales_order_path(@order.id), class: 'btn' if policy(@order).update?

    = link_to "Print Order", sales_order_path(@order.id, format: 'print'), class: 'btn' 



.row-fluid
  %h4.ib
    = link_to @order.contact, partner_path(@order.contact.id), title: 'Contacto', data: { toggle: 'tooltip' }


  %h5.n.ib
    %span.muted Fecha:
    %i= @order.date
    = render_if @order.delivery_date do
      = @order.delivery_date



.row-fluid
  .span6
    .moneybox
      %label TOTAL
      %h5.n
        %span.total= format_amount(@order.total, @order.currency)
        = @order.currency



  .span6
    -#%span.muted Proyecto:
    -#= link_to @order.project, @income.project if @income.project
    .clearfix

%div.row
  %div.col-3 Ship From:
  %div.col-3= @order.store.name
  %div.col-3= @order.ship_date

= render "orders/items"

- unless @order.draft?
  .row-fluid
    -# Ledgers
    .span6.bg-white
      -# = render 'ledger_details', income: @order

    -# Inventory
    #inventory.span6.bg-white
      -# = render 'inventory_details', income: @order



-#Tours
-#= render 'incomes/tour_devolution'

:javascript
  $( function() {
    // null income
    $('#null-income-form').submit(function(event) {
      if(confirm('Esta segur@ de anular el Ingreso?')) {
        return true;
      }else{
        return false;
      }
    })
  });
