
%li.row-fluid.account_ledger(id='#{ledger.id}')
  .span5
    %h4.ib
      = link_to ledger, {controller:'transferences', action:"show", entry_no: ledger.entry_no}, class: 'code', title: 'Código'
    %strong= ledger.operation

    = ledger.status

    %p
      %i= l ledger.date.to_date
      %span.muted De:
      = link_to ledger.account.name, ledger.account
  .span5
    = ledger.updater
    = ledger.creator
    = ledger.approver
    = ledger.nuller
    .clearfix

  .span2.r
    = ntc ledger.amount
    = currency_label ledger.currency
