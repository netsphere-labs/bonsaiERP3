
%tr
  %td= l ledger.date
  %td
    = link_to ledger.entry_no, {controller:'transferences', action:"show", entry_no: ledger.entry_no}, class: 'code', title: 'Código'
  %td ●未実装

  - if ledger.amount >= 0
    %td
      = ntc ledger.amount
      = currency_label ledger.currency
    %td
  - else
    %td
    %td
      = ntc -ledger.amount
      = currency_label ledger.currency

  %td ●未実装

  %td
    = ledger.updater
    = ledger.creator
    = ledger.approver
    = ledger.nuller

