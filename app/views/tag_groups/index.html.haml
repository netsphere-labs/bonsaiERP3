
:ruby
  @page_title = "Grupos de etiquetas"

- content_for :links do
  %div.btn-group{role:"group"}
    = link_to "New Tag Group...", new_tag_group_path, class: 'btn' 




%ul#tag-groups.unstyled.listing
  - @tag_groups.each do |tag_group|
    %li
      = link_to tag_group.name, tag_group_path(tag_group.id) 

      %tagsfor(tag_ids="#{tag_group.tag_ids}" id="#{tag_group.id}")
