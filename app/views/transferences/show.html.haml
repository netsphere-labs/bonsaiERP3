
:ruby
  @page_title = "振替伝票: ##{@journal_entry.entry_no}"
  @crumbs = [
    ["仕訳帳", transferences_path] ]

%p
  Date:
  = @journal_entry.date
  Entry No.:
  = @journal_entry.entry_no

%table(class='table table-sm')
  %tr
    %th Account
    %th Partner
    %th Description
    %th(colspan='2') Dr.
    %th(colspan='2') Cr.
    %th Bp Bank Account

  - @journal_entry.lines.each do |je_line|
    %tr
      %td= je_line.account.name
      %td= je_line.partner &.name
      %td= je_line.description
      - if je_line.funct_amount >= 0
        %td= format_amount(je_line.funct_amount, current_organisation.currency)
        %td
          - if je_line.fx_amount
            = format_amount(je_line.fx_amount, je_line.fx_curr_code)
            = je_line.fx_curr_code
        %td
        %td
      - else
        %td
        %td
        %td= format_amount(-je_line.funct_amount, current_organisation.currency)
        %td
          - if je_line.fx_amount
            = format_amount(-je_line.fx_amount, je_line.fx_curr_code) 
            = je_line.fx_curr_code
      %td= je_line.bp_bank_account &.long_name
