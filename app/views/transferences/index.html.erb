
<% @page_title = "仕訳帳 (Journal)" %>

<%= form_with model: @search, url:"/transferences/", method: :get do |f| %>
  <label>From <%= f.date_field :from %></label>
  <label>To <%= f.date_field :to %></label>
  <%= f.submit 'Show', class: 'btn btn-primary' %>
<% end %>

<p><%= link_to "New journal entry...", new_transference_path %>
  
<%== @pagy.series_nav(:bootstrap) %>

<table class="table table-sm">
  <tr>
    <th>日付
    <th>Entry No.
    <th>勘定科目
    <th>借方
    <th>貸方
<% funct_curr = current_organisation.currency
   cur_entry_no = nil
   @journal_entries.each do |je_line| %>
  <tr>
    <td><%= cur_entry_no != je_line.entry_no ? je_line.date : '' %>
    <td><%= cur_entry_no != je_line.entry_no ? je_line.entry_no : '' %>
    <td><%= je_line.account.name %>
<% if je_line.funct_amount >= 0 %>
    <td><%= format_amount(je_line.funct_amount, funct_curr) %> 
    <td>
<% else %>      
    <td> <td><%= format_amount(-je_line.funct_amount, funct_curr) %> 
<% end %>
    <td><%= cur_entry_no != je_line.entry_no ?
	    (link_to "Show", {action:"show", entry_no: je_line.entry_no}) : '' %>
<%   cur_entry_no = je_line.entry_no %>
<% end %>
</table>

<%== @pagy.series_nav(:bootstrap) %>
