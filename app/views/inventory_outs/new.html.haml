
:ruby
  @page_title = "Transfer Out"

=link_to "Back", outbound_orders_store_path(@invt.store)

.row-fluid
  .span12
    %h2
      = @invt.model_obj.ref_number
      %small.text-error Egreso de items

%div
  = bootstrap_form_with model: @invt, url: {controller:"inventory_outs", action:"create", store_id: @invt.store_id}, layout: :horizontal do |f|

    = error_messages_for 'invt' 
    = hidden_field_tag :order_id, @order.id 

    .row-fluid
      .span3
        %label Almacen
        %h4.n= link_to @invt.store, @invt.store, target: '_blank'
      .span3
        = f.date_field :date, label: 'Fecha', as: :datepicker
      .span6
        = f.text_field :description, as: :text, label: 'Description' ,input_html: { rows: 3, cols: 55 }

    
    .row-fluid
      = render 'form', f: f

    .form-actions
      = f.submit 'Egresar ítems', class: 'btn btn-primary b'
