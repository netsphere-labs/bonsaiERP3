
<% @page_title = "Goods Receipt PO ##{@invt.id}" %>
<% @crumbs = [
     ["Store/Warehouse", stores_path],
     [@store.name, @store],
     ["Inbound Delivery", {controller:"stores", id: @store, action:"inbound_orders"}] ] %>

<% content_for :links do %>
  <div class="btn-group" role="group">
<% if policy(@invt).update? %>
  <%= link_to 'Edit...', {action:"edit", id:@invt} %>
<% end %>
<% if policy(@invt).destroy? %>
  <%= button_to 'Destroy', {action:"destroy", id:@invt.id}, method: :delete, class: 'btn btn-danger',
                data:{turbo_confirm: 'Sure?'}  %>
<% end %>
  
<% if policy(@invt).confirm? %>
  <%= button_to 'Confirm', {action:"confirm", id:@invt} %>
<% end %>
  </div>
<% end %>

<em style="color:red">● TODO:</em>
<ul>
  <li>受領登録のときの <code>OrderDetail#price</code> は取引通貨. <code>InventoryDetail#txn_price</code> も取引通貨。<code>unitary_cost</code> は機能通貨建て。ここで換算が必要
</ul>

<table>
  <tr><th>Account: <td><%= @invt.account.name %>
  <tr><th>State: <td><%= @invt.state %>
</table>


  
<table class="table">
  <tr>
    <th>Item
    <th>Price (取引通貨)
    <th>Qty
    <th>Amount
      
  <% @invt.details.each do |detail| %>
  <tr>
    <td><%= detail.item.name %>
    <td><%= detail.txn_price %>
    <td><%= detail.quantity %>
    <td><%= detail.txn_price * detail.quantity %>
  <% end %>
</table>
