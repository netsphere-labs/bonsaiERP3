
:ruby
  @page_title = "Store: " + @store.name
  @crumbs = [
    ["Store/Warehouse", stores_path] ]


- content_for :links do
  %div.btn-group{role: "group"}
    = link_to "Edit...", edit_store_path(@store.id), class: 'btn'

    = button_to "Destroy", store_path(@store.id), method: :delete,
                data:{turbo_confirm: "Esta seguro de borrar el almacen?"}, class: 'btn btn-outline-danger'



%table.table
  %tr
    %th Name
    %td= @store.name
  %tr
    %th Active
    %td= @store.active
  %tr
    %th Address
    %td= @store.address
  %tr
    %th Phone
    %td= @store.phone


