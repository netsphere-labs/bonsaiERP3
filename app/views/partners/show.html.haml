
:ruby
  @page_title = "Partner: " + @partner.name
  @crumbs = [
    ["Business Partners", partners_path] ]


- content_for :links do
  %div.btn-group{role: "group"}
    = link_to "Edit...", edit_partner_path(@partner), class: 'btn'
    = button_to "Destroy", partner_path(@partner), class: 'btn btn-outline-danger', data: { turbo_confirm: "Esta seguro de borra el contacto" }, method: :delete



%table
  %tr
    %th Matchcode:
    %td= @partner.matchcode
  %tr
    %th Email:
    %td= @partner.email
  %tr
    %th Tax Number:
    %td= @partner.tax_number
  %tr
    %th Address:
    %td= @partner.address
  %tr
    %th Phone:
    %td= @partner.phone
  %tr
    %th Mobile:
    %td= @partner.mobile



%h2 Bank accounts
- @partner.contact_accounts.each do |ca|
  = render ca

%p
  = link_to "New bank account...", new_partner_contact_account_path(@partner)



%h2 Transactions 取引先との取引の一覧

%ul(class='nav nav-tabs')
  %li.nav-item
    = link_to "Todas", partner_path(@partner, operation: :all), class: 'nav-link'
  %li.nav-item
    = link_to "Ingresos", partner_path(@partner, operation: :income), class: param_bold_for(:operation, 'income')
  %li.nav-item
    = link_to "Expenses", partner_path(@partner, operation: :expense), class: param_bold_for(:operation, 'expense')
  %li.nav-item
    = link_to "Prestamos otorgados", partner_path(@partner, operation: :loangive), class: param_bold_for(:operation, 'loangive')
  %li.nav-item
    = link_to "Prestamos recibidos", partner_path(@partner, operation: :loanreceive), class: param_bold_for(:operation, 'loanreceive')


- orders = @partner.op_list(:all).limit(10)

%ul.listing.unstyled(style='margin-top: 10px')
  %li.row-fluid
    .span8
    .span4
      .span6
        %strong.muted Total
      .span6
        %strong.muted Saldo

  - orders.each do |order|
    = order.inspect  # TODO: impl.


