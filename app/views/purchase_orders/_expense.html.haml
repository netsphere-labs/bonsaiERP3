
-# @param order order object

%tr
  %td= order.date
  %td= link_to order.contact, partner_path(order.contact.id)
  %td= order.state
  %td= order.delivery_date
  %td(style='text-align:right')
    = format_amount(order.total, order.currency)
    = order.currency
  %td
    = link_to "[Show]", order

