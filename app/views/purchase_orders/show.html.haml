
:ruby
  @page_title = "Purchase Order ##{@order.id}"
  @crumbs = [
    ["Purchase Order", purchase_orders_path] ]


- content_for :links do
  %span{class: @order.display_state}= @order.state

  %div.btn-group{role: "group"}
    - if policy(@order).confirm?
      = button_to 'Confirm', confirm_purchase_order_path(@order.id), class: 'btn btn-success', method: :patch  

    - if @order.state == "confirmed"
      = link_to "Purchase-in-Transit...", new_pur_in_transit_path(po_id: @order.id), class:"btn" 
    - else
      %a(class="btn disabled") Purchase-in-Transit...

    - if policy(@order).destroy?
      = button_to 'Delete', purchase_order_path(@order.id), method: :delete, class: 'btn btn-outline-danger', data:{turbo_confirm: 'Sure?'}  
    - elsif policy(@order).void?
      = button_to 'Void', void_purchase_order_path(@order.id), method: :patch, class: 'btn btn-outline-danger', data:{turbo_confirm: 'Esta segur@ de anular el Ingreso?'}  
    - else
      %a(class="btn disabled") Delete

    -# = button_to 'Force Close', {action:"force_close"}
    - if policy(@order).update?
      = link_to "Edit...", edit_purchase_order_path(@order.id), class: 'btn'  
    - else
      %a(class="btn disabled") Edit...


%div.row
  %div.col-2 Partner:
  %div.col-6
    = link_to @order.contact, partner_path(@order.contact.id), title: 'Contacto', data: {toggle: 'tooltip'}
  %div.col-2 To:
  %div.col-2= @order.store.name

%div.row
  %div.col-2 Order Date:
  %div.col-2= @order.date
  %div.col-2 Delivery Date:
  %div.col-2= @order.ship_date
  %div.col-2 Arrival Date:
  %div.col-2= @order.delivery_date


.row-fluid.expense
  .span6
    .moneybox
      %label TOTAL
      %h5.n
        %span.total= format_amount(@order.total, @order.currency)
        = @order.currency




= render "orders/items"


.row-fluid
  .span6
    %h3 Adjuntos
    = render 'attachments/attachments', attachable: @order



%h2 Purchase In Transit

%em{style:"color:red"} TODO:
%ul
  %li リンクがおかしい

- Inventory.where(operation:'pur_tran', order: @order).each do |invt|
  = render 'inventories/movement', inventory: invt


%h2 Goods Receipt PO

- Inventory.where(operation:['pit_in', 'exp_in'], order:@order).each do |invt|
  = render 'inventories/movement', inventory: invt




