
- @page_title = "Purchase Order"

- content_for :links do
  %div.btn-group{role:"group"}
    = link_to "Export", export_expenses_path, class: 'btn btn-secondary' 

    = link_to "New Purchase Order...", new_purchase_order_path, class: 'btn btn-secondary'


= render partial: 'orders/search'


- paginate_html = @pagy.series_nav(:bootstrap).html_safe

=paginate_html

%table(class='table')
  %tr
    %th order_date
    %th Partner
    %th status
    %th Arrival Date
    %th total amount

  - @orders.each do |order|
    = render 'purchase_orders/expense', order: order

=paginate_html

