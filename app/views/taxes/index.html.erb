
<% @page_title = "Tax" %>

<% content_for :links do %>
  <div class="btn-group" role="group">
    <%= link_to 'New Tax...', new_tax_path, :class => 'new' %>
  </div>
<% end %>

<table class="table">
  <tr>
    <th>Country
    <th>Name
    <th>Abbr.
    <th>%
      
<% @taxes.each do |tax| %>
  <tr>
    <td><%= tax.country_code %>
    <td><%= tax.name %>
    <td><%= tax.abbreviation %>
    <td><%= tax.percentage %>
    <td><%= link_to "Edit...", action:"edit", id: tax %>
<% end %>
</table>
