
<% @page_title = "Delivery ##{@invt.id}" %>
<% @crumbs = [
     ["Store/Warehouse", stores_path],
     [@store.name, @store],
     ["Outbound Delivery", {controller:"stores", id: @store, action:"outbound_orders"}] ] %>


<% content_for :links do %>
  State: <%= tag.span class: @invt.display_state do %> <%= @invt.state %><% end %>


  <div class="btn-group" role="group">
<% if policy(@invt).update? %>
  <%= link_to 'Edit...', {action:"edit", id:@invt} %>
<% end %>
<% if policy(@invt).destroy? %>
  <%= button_to 'Destroy', {action:"destroy", id:@invt.id}, method: :delete, class: 'btn btn-danger',
                data:{turbo_confirm: 'Sure?'}  %>
<% end %>
  
<% if policy(@invt).confirm? %>
  <%= button_to 'Confirm', {action:"confirm", id:@invt} %>
<% end %>
  </div>
<% end %>




  
<table class="table">
  <tr>
    <th>Item
    <th>Price (取引通貨)
    <th>Qty
    <th>Amount
      
  <% @invt.details.each do |detail| %>
  <tr>
    <td><%= detail.item.name %>
    <td><%= format_amount(detail.unit_price, @invt.curr_code) %>
    <td><%= detail.quantity %>
    <td><%= format_amount(detail.txn_amount, @invt.curr_code) %>
      <%= @invt.curr_code %>
  <% end %>
</table>
