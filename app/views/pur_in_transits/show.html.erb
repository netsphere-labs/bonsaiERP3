
<% @page_title = "Purchase In Transit ##{@invt.id}" %>
<% @crumbs = [
     ["Purchase In Transit", {action:"index"}] ] %>

<% content_for :links do %>
  <div class="btn-group" role="group">
<% if policy(@invt).update? %>
  <%= link_to 'Edit...', {action:"edit", id:@invt} %>
<% end %>
<% if policy(@invt).confirm? %>
  <%= button_to 'Confirm', {action:"confirm", id:@invt} %>
<% end %>
  </div>
<% end %>

<em style="color:red">● TODO:</em>
<ul>
  <li>受領登録のときの price は外貨建てだが, <code>InventoryDetail</code> クラスは機能通貨建て。ここで換算が必要
</ul>

<table>
  <tr><th>State: <td><%= @invt.state %>
</table>


  
<table class="table">
  <tr>
    <th>Item
    <th>Price (<%= @invt.curr_code %>)
    <th>Qty
    <th>Amount
      
  <% @invt.details.each do |detail| %>
  <tr>
    <td><%= detail.item.name %>
    <td><%= format_amount(detail.unit_price, @invt.curr_code) %>
    <td><%= detail.quantity %>
    <td><%= format_amount(detail.txn_amount, @invt.curr_code) %>
      <%= @invt.curr_code %>
  <% end %>
</table>
