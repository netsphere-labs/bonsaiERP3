
:ruby
  @page_title = "Product/Item: " + @item.name
  @crumbs = [
    ["Product/Item Master", items_path] ]


- content_for :links do
  %div.btn-group{role: "group"}
    = link_to "Edit this item...", edit_item_path(@item), class: 'btn'
    = button_to "Destroy this item", @item, class: 'btn btn-outline-danger', data:{turbo_confirm: "Esta seguro de borra el ítem"}, method: :delete

    = link_to "BoM Structure", item_bom_structures_path(@item), class: 'btn'

%div.row
  %div.col Name:
  %div.col= @item.name

%div.row
  %div.col Code:
  %div.col= @item.code

%div.row
  %div.col Active:
  %div.col= @item.active

  .span3
    %span.text-muted.muted Venta:
    %span.for_sale.icon(class="icon-large icon-#{@item.for_sale}")

  .span6
    %span.text-muted.muted Unidad:
    %span.unit= @item.unit

.row-fluid
  .span6.well.well-small
    %span.text-muted.muted Precio de COMPRA
    %strong= @item.buy_price

  .span6.well.well-small
    %span.text-muted.muted Precio de VENTA:

    %strong= @item.price

.row-fluid
  .span6
    %label Description
    = @item.description

.row-fluid
  .span6
    %h3 Adjuntos
    = render 'attachments/attachments', attachable: @item

  .span6
    %h3.n Historial

    %ul.unstyled
      = render partial: 'histories/history', collection: @item.histories


