
- @page_title = "Product/Item Master"

- content_for :links do
  %div.btn-group{role: "group"}
    = link_to "New Item...", new_item_path, class: 'btn btn-secondary'


= render 'search'
%p
  = @search.nothing? ? "" : "Search: " + @search.attributes.inspect


- paginate_html = @pagy.series_nav(:bootstrap).html_safe
= paginate_html

%table(class='table table-sm')
  %tr
    %th Code
    %th Name
    %th UoM
    %th Active?
    %th Description
    %th saleable?
    %th stockable?
  - @items.each do |item|
    =render item

= paginate_html


