
= form_with model:@search, url: inventories_path, method: 'get', class: 'form-inline' do |f|
  = render 'layouts/date_range', form: f
  = f.submit 'Buscar', class: 'btn'



:javascript
  $(function() {
    function disableEnableDates() {
      var prop;
      if($('#search').val().trim() == '') {
        prop = false;
      }else {
        prop = true;
      }

      $('#date_start_picker').prop('disabled', prop);
      $('#date_end_picker').prop('disabled', prop);
    }

    $('#search').on('keyup', function(event) { disableEnableDates() });
    disableEnableDates();
  });

