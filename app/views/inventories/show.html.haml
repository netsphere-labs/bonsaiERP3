
:ruby
  @page_title = "入出庫伝票: ##{@invt.id}"
  @crumbs = [
    ["入出庫伝票", inventories_path] ]

- content_for :links do
  %div.btn-group{role: "group"}
    = link_to "Print", inventory_path(@invt, format: 'print'), class: 'btn' 


%table.table
  %tr
    %th Date:
    %td= @invt.date
  %tr
    %th Ref. Number:
    %td= @invt.ref_number
  %tr
    %th Store:
    %td
      = link_to @invt.store.name, store_path(@invt.store, anchor: 'operations-tab')
  %tr
    %th Op. Inventario:
    %td= @invt.operation
  %tr
    %th Description:
    %td= @invt.description
  %tr
    %th Creator:
    %td
      = @invt.creator
      = @invt.created_at




%h2 Items

%table#items.table.decorated
  %tr
    %th Item
    %th Cantidad
    %th Unidad

  - @invt.details.includes(:item).each do |det|
    %tr.item
      %td
        = det.item
      %td
        = ntc det.quantity
      %td
        = det.item.unit_symbol
