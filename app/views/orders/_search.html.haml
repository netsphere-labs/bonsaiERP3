
-# @param @search search object

.search
  = form_with model: @search, url:{action:"index"}, method: "get" do |f|
    %div(class="row mb-3")
      %label(class="col-sm-2 col-form-label")
        Text:
      %div(class="col-sm-10")
        = f.text_field :search, placeholder: t("views.incomes.index.search.search_placeholder")
    %div(class="row mb-3")
      %label(class="col-sm-2 col-form-label")
        Order Date:
      %div(class="col-sm-4")
        = f.date_field :date_start
        = f.date_field :date_end
      %label(class="col-sm-2 col-form-label")
        Arrival Date:
      %div(class="col-sm-4")
        = f.date_field :arrival_date_start
        = f.date_field :arrival_date_end

    %div(class="row mb-3")
      %label(class="col-sm-2 col-form-label")
        Status:
      %div(class="col-sm-10")
        - Order::STATES.each do |st|
          %div(class="form-check form-check-inline")
            %label(class="form-check-label")
              = f.check_box 'state', {multiple:true, checked: @search.state.include?(st), class:"form-check-input"}, st
              = st

      = f.number_field :overdue

    = f.submit "Filter", class: "btn btn-primary"
    = f.submit 'Reset', name:"reset", class: 'btn btn-secondary'
