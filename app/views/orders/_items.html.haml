
-# @param @order sales_order or purchase_order

#items
  %h2 Items

  %table(class='table table-sm')
    %thead
      %tr
        %th Item
        %th Unit Price (#{@order.currency})
        %th Qty
        %th UoM
        %th Amount (#{@order.currency})
        %th description
        %th Undelivered qty

      - @order.details.includes(:item => [:unit]).each do |det|
        %tr
          %td= link_to det.item.name, det.item, 'data-title' => det.item
          %td(style='text-align:right')= format_amount(det.unit_price, @order.currency)
          %td(style='text-align:right')= det.quantity
          %td(style='text-align:right')= det.item.unit
          %td(style='text-align:right')= format_amount(det.amount, @order.currency)
          %td= det.description
          %td(style='text-align:right')= det.balance

    %tr.extra.pad_top
      %td
      %td.cur{:colspan => 3} Subtotal
      %td(style='text-align:right')= format_amount(@order.gross_total, @order.currency)

    %tr.extra
      %td
      %td.cur{:colspan => 3}
        %i.icon-minus-sign
        Descuento (<span id="discount_percentage" data-val="#{@order.discount_percent}">#{@order.discount_percent}</span>%)
      %td(style='text-align:right')= format_amount(-@order.total_discount, @order.currency)

    %tr.extra
      %td
        %td.cur.b.dark{:colspan => 3} Total
      %td(style='text-align:right') #{@order.currency} #{format_amount(@order.total, @order.currency)}


